{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["resources/js/*"]
    },
    "types": ["node"],
    "allowJs": true,
    "strict": true,
    "moduleResolution": "node",
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["resources/js/**/*.ts", "resources/js/**/*.d.ts", "resources/js/**/*.vue"]
}
